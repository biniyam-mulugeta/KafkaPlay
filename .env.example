# Offsetscope configuration.
#
# Copy to .env and edit. Everything has a safe default except SESSION_SECRET.
#   cp .env.example .env
#
# Secrets belong here (or in Docker secrets), never in config/clusters.yaml.
# .env is git-ignored.

# =============================================================================
# Identity and appearance
# =============================================================================

# Product name shown in the UI and the browser tab.
APP_NAME=Offsetscope

# Which themes/<name>/ directory to load. Ships with: offsetscope, neutral.
# Add your own by mounting a directory -- no rebuild needed.
THEME=offsetscope

# Interface language on first visit: en | hu
DEFAULT_LOCALE=en

# =============================================================================
# Serving
# =============================================================================

# Host interface the container publishes on. 127.0.0.1 means "this machine
# only", which is the right default; reach it over an SSH tunnel:
#   ssh -L 8080:localhost:8080 user@server
CONSOLE_BIND=127.0.0.1
CONSOLE_PORT=8080

# Set when serving under a reverse-proxy subpath, e.g. /kafka
# ROOT_PATH=

# =============================================================================
# Safety
# =============================================================================

# Global kill switch for every write. Turn this ON when pointing the console at
# a production cluster you do not intend to change. It overrides user roles:
# even an admin cannot write while this is true.
READ_ONLY=false

# =============================================================================
# Authentication
# =============================================================================

# local | oidc | none
#
#   local  username + password, stored here with bcrypt hashing
#   oidc   Keycloak / Google / GitHub / Entra (see docs/security.md)
#   none   NO AUTHENTICATION AT ALL. Every visitor is an administrator.
#          Permitted only on a loopback bind unless ALLOW_INSECURE_NO_AUTH=true.
AUTH_MODE=local

# REQUIRED unless AUTH_MODE=none. At least 32 characters. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Changing it invalidates every active session, which is the emergency lever.
SESSION_SECRET=

# Acknowledgement required to run AUTH_MODE=none on a non-loopback bind.
# Inside Docker the app always binds 0.0.0.0, so container users must set this
# explicitly. That is deliberate friction, not a bug.
# ALLOW_INSECURE_NO_AUTH=false

# The first admin, created once on an empty database. If ADMIN_PASSWORD is left
# blank, a random one is generated and printed to the log exactly once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# How long a session lasts, in seconds (default 12 hours).
# SESSION_MAX_AGE_SECONDS=43200

# Set true when serving over HTTPS so cookies carry the Secure flag.
SECURE_COOKIES=false

# =============================================================================
# Clusters
# =============================================================================

# Cluster definitions. Supports ${VAR} substitution, so put passwords in this
# file and reference them from the YAML.
CLUSTERS_FILE=/config/clusters.yaml

# Referenced by config/clusters.yaml in the examples:
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# SCHEMA_REGISTRY_USERNAME=
# SCHEMA_REGISTRY_PASSWORD=

# Only needed for docker-compose.yml networking setup (b): joining an existing
# Docker network from another compose project. Find the real name with
# `docker network ls`. There is deliberately no default.
# KAFKA_NETWORK=

# =============================================================================
# Metrics
# =============================================================================

# The built-in sampler records consumer-group and log-end offsets into SQLite,
# so lag history, velocity, time-to-catch-up, throughput and the partition
# heatmap all work with NO Prometheus and NO JMX. This is on by default.
SAMPLER_ENABLED=true
SAMPLER_INTERVAL_SECONDS=30
SAMPLER_RETENTION_DAYS=7

# Above this partition count the sampler lengthens its interval automatically
# rather than adding load to a large cluster.
# SAMPLER_MAX_PARTITIONS=2000

# OPTIONAL. Set only if you run the `metrics` profile or already have
# Prometheus. It unlocks broker-level and replication JMX charts; everything
# else works without it.
# PROMETHEUS_URL=http://prometheus:9090
# PROM_RETENTION=15d

# =============================================================================
# Privacy
# =============================================================================

# Masks IP addresses, emails, card-like numbers and JWTs in every message view.
# Message payloads are never written to disk regardless of this setting.
# Per-cluster and per-topic rules go in config/clusters.yaml.
MASKING_ENABLED=true

# =============================================================================
# Broker call budget
# =============================================================================

# ADMIN_TIMEOUT_SECONDS=10
# Shared cache so several open browser tabs cost one broker call, not N.
# ADMIN_CACHE_TTL_SECONDS=5

# =============================================================================
# Logging and storage
# =============================================================================

LOG_LEVEL=INFO
# json for production (structured, one object per line), console for humans.
LOG_FORMAT=json

DATABASE_URL=sqlite:////data/offsetscope.db

# =============================================================================
# Notifications (M6). Both are unconfigured by default.
# =============================================================================

# Generic webhook. Requests carry an HMAC signature in X-Offsetscope-Signature.
# WEBHOOK_URL=
# WEBHOOK_SECRET=

# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=offsetscope@example.org
# SMTP_STARTTLS=true

# Seeder rate for the dev stack, in events per second.
# SEED_RATE=25
